# 🔐 GitHub Token (NEVER COMMIT THIS FILE!)
# Copy this file to .env and add your actual token
# .env will be ignored by git

GITHUB_TOKEN=ghp_your_token_here_replace_this

# Usage:
# 1. cp .env.example .env
# 2. Edit .env and paste your real token
# 3. source .env
# 4. git push https://oauth2:${GITHUB_TOKEN}@github.com/...
